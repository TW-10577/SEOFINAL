# Copy to .env (not committed) and fill in. The API reads DATABASE_URL from the environment first, then from this file.
# PostgreSQL connection for the LOGOS SEO API.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5433/logos_seo
# Optional: database for `npm test` (default: DATABASE_URL with "_test" appended to the database name).
# TEST_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5433/logos_seo_test
# Optional: connection timeout in milliseconds (default 10000).
# DATABASE_CONNECT_TIMEOUT_MS=10000
