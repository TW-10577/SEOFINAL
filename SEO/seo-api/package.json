{
  "name": "seo-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:synthetic": "SEO_DB_PATH=../database/seo-synthetic.db tsx watch src/main.ts",
