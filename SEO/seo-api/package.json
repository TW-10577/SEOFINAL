  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
